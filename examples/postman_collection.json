          "raw": "{{baseUrl}}/api/policy-requests/1/submit",
          "host": ["{{baseUrl}}"],
          "path": ["api", "policy-requests", "1", "submit"]
        }
      }
    },
    {
      "name": "5. Submit Policy (TIMEOUT_AFTER_ISSUE Scenario)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scenario\": \"TIMEOUT_AFTER_ISSUE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/policy-requests/1/submit",
          "host": ["{{baseUrl}}"],
          "path": ["api", "policy-requests", "1", "submit"]
        }
      }
    },
    {
      "name": "6. Reconcile Policy with Insurer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/policy-requests/1/reconcile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "policy-requests", "1", "reconcile"]
        }
      }
    },
    {
