      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"EVT-TEST-001\",\n  \"provider_reference\": \"PRV-SAMPLE123\",\n  \"policy_number\": \"POL-20261023-ABCDEF\",\n  \"status\": \"CONFIRMED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/mock-insurer/callback",
          "host": ["{{baseUrl}}"],
          "path": ["api", "mock-insurer", "callback"]
        }
      }
    },
    {
      "name": "8. List Policy Requests (Filtered & Paginated)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/policy-requests?status=ISSUED&per_page=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "policy-requests"],
          "query": [
            { "key": "status", "value": "ISSUED" },
            { "key": "per_page", "value": "10" }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ]
