{
  "info": {
    "name": "PolicyFlow API Collection",
    "description": "Fault-Tolerant Insurance Issuance & Reconciliation Engine REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Policy Intake (Create New Request)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_request_id\": \"AGT-2026-0001\",\n  \"agent_id\": \"AGENT-17\",\n  \"customer_name\": \"Sample Customer\",\n  \"date_of_birth\": \"1998-04-10\",\n  \"destination\": \"INTERNATIONAL\",\n  \"trip_start\": \"2026-11-10\",\n  \"trip_end\": \"2026-11-14\",\n  \"plan_code\": \"PLUS\",\n  \"sum_insured\": 300000\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/policy-requests",
          "host": ["{{baseUrl}}"],
          "path": ["api", "policy-requests"]
        }
      }
    },
    {
      "name": "2. Policy Intake (Duplicate - Idempotent 200)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_request_id\": \"AGT-2026-0001\",\n  \"agent_id\": \"AGENT-17\",\n  \"customer_name\": \"Sample Customer\",\n  \"date_of_birth\": \"1998-04-10\",\n  \"destination\": \"INTERNATIONAL\",\n  \"trip_start\": \"2026-11-10\",\n  \"trip_end\": \"2026-11-14\",\n  \"plan_code\": \"PLUS\",\n  \"sum_insured\": 300000\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/policy-requests",
          "host": ["{{baseUrl}}"],
          "path": ["api", "policy-requests"]
        }
      }
    },
    {
      "name": "3. Get Policy Details & Audit Trail",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/policy-requests/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "policy-requests", "1"]
        }
      }
    },
    {
      "name": "4. Submit Policy for Issuance (SUCCESS)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
